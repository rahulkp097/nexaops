# Database
# NOTE: host port is 55432, not 5432 — see docker-compose.yml comment.
# This is the connection string for host-side tools (migrations, running
# gateway/ai-service outside Docker). Inside Docker Compose, services use
# the internal hostname/port (postgres:5432) via compose `environment:` overrides.
DATABASE_URL=postgresql://nexaops:nexaops@localhost:55432/nexaops

# Database roles (Phase 1) — app role is least-privilege read-write,
# readonly role is used by the NL-to-SQL tool (Phase 12).
DB_APP_PASSWORD=changeme-app-password
DB_READONLY_PASSWORD=changeme-readonly-password
DATABASE_APP_URL=postgresql://nexaops_app:changeme-app-password@localhost:55432/nexaops
DATABASE_READONLY_URL=postgresql://nexaops_readonly:changeme-readonly-password@localhost:55432/nexaops

# Redis
# NOTE: host port is 56379, not 6379 — see docker-compose.yml comment.
REDIS_URL=redis://localhost:56379

# RabbitMQ
RABBITMQ_URL=amqp://nexaops:nexaops@localhost:5672

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# AI
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Embeddings (Phase 4/5) — local, in-process, zero-cost. 384-dim, matching
# the document_chunks.embedding column — changing this requires a new
# migration/table, not just this var.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=8
MODEL_CACHE_DIR=./.cache/transformers

# Ingestion (Phase 4)
CHUNK_TARGET_TOKENS=230
CHUNK_OVERLAP_TOKENS=40
INGESTION_MAX_ATTEMPTS=5

# RAG (Phase 6/7)
RAG_TOP_K=8
RAG_MAX_ANSWER_TOKENS=2048
RAG_CANDIDATE_POOL_SIZE=20

# Tool layer (Phase 11) — mock-business is Phase 10's deterministic
# operational API; ai-service's tools call it directly (no tenant scoping,
# see app/tools/business_client.py).
MOCK_BUSINESS_URL=http://localhost:4200
TOOL_CALL_TIMEOUT_SECONDS=5.0

# Safe NL-to-SQL (Phase 12)
SQL_GENERATION_MAX_TOKENS=300
SQL_ROW_LIMIT=100

# Agent orchestration bounds (Phase 13)
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=45.0
AGENT_MAX_TOKENS_PER_TURN=1024
AGENT_MAX_TOTAL_TOKENS=20000

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
MAX_DOCUMENT_SIZE_MB=25

# App
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
