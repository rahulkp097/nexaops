# Production environment template (Phase 26 — see docs/deployment/runbook.md
# for the full deployment order and the two real bugs this phase's
# hardening pass found). Placeholders only — never commit real values.
#
# Every URL below that points at a Docker Compose service hostname
# (postgres/redis/rabbitmq/ai-service) needs to become the real provisioned
# service's address once one exists; nothing here is live.

# Database — a real Postgres 16-compatible instance with the pgvector
# extension enabled (confirm the provider allows CREATE EXTENSION vector
# before committing to one). Run migrations against this before anything
# else starts.
DATABASE_URL=postgresql://<user>:<password>@<real-postgres-host>:5432/nexaops

# Database roles (Phase 1) — freshly generated, strong passwords, not the
# local dev placeholders. The readonly role must keep
# default_transaction_read_only set (backs the NL-to-SQL tool, Phase 12).
DB_APP_PASSWORD=<generate-a-real-secret>
DB_READONLY_PASSWORD=<generate-a-real-secret>
DATABASE_APP_URL=postgresql://nexaops_app:${DB_APP_PASSWORD}@<real-postgres-host>:5432/nexaops
DATABASE_READONLY_URL=postgresql://nexaops_readonly:${DB_READONLY_PASSWORD}@<real-postgres-host>:5432/nexaops

# Redis — a real managed instance. Nothing depends on this at boot other
# than the Phase 20 cache, which degrades to a plain miss on any Redis
# error — so this can come up after everything else without blocking it,
# but latency/cost benefits disappear until it's real.
REDIS_URL=redis://<real-redis-host>:6379

# RabbitMQ — a real managed AMQP-compatible queue. Recreate the exchange/
# queue/DLQ topology from docs/architecture/rabbitmq-topology.md before
# either the gateway or document-worker starts consuming.
RABBITMQ_URL=amqp://<user>:<password>@<real-rabbitmq-host>:5672

# Auth — freshly generated, high-entropy secrets. Never reuse the local
# dev values, and never commit these anywhere.
JWT_SECRET=<generate-a-real-secret>
JWT_REFRESH_SECRET=<generate-a-real-secret>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# AI — needs a real Anthropic API key on an account with an actual funded
# credit balance. This project's own account currently has zero balance
# (BUILD_PLAN.md's known gap) — a real deployment behaves no differently
# until that's resolved.
AI_PROVIDER=anthropic
AI_API_KEY=<real-anthropic-api-key>
AI_MODEL=claude-sonnet-5

# Embeddings — unchanged from local dev; this runs in-process, not a
# hosted API, so there's nothing provider-specific to configure.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=8
MODEL_CACHE_DIR=./.cache/transformers

# Ingestion — unchanged from local dev.
CHUNK_TARGET_TOKENS=230
CHUNK_OVERLAP_TOKENS=40
INGESTION_MAX_ATTEMPTS=5

# RAG — unchanged from local dev.
RAG_TOP_K=8
RAG_MAX_ANSWER_TOKENS=2048
RAG_CANDIDATE_POOL_SIZE=20

# Tool layer — mock-business's real deployed URL.
MOCK_BUSINESS_URL=http://<real-mock-business-host>:4200
TOOL_CALL_TIMEOUT_SECONDS=5.0

# Safe NL-to-SQL — unchanged from local dev.
SQL_GENERATION_MAX_TOKENS=300
SQL_ROW_LIMIT=100

# Agent orchestration bounds — unchanged from local dev.
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=45.0
AGENT_MAX_TOKENS_PER_TURN=1024
AGENT_MAX_TOTAL_TOKENS=20000

# Storage — 'local' is the ONLY implemented provider
# (apps/gateway/src/documents/storage/storage.provider.ts throws on
# startup for anything else). Deploying the gateway and document-worker as
# genuinely separate services (spec's own instruction) needs a real
# object-storage backend implemented first — see docs/deployment/
# runbook.md. Until then, this variable has no other valid value.
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
MAX_DOCUMENT_SIZE_MB=25

# App — real public hostnames, not localhost. CORS_ORIGINS is a hard
# security boundary the gateway already enforces (a wrong value here is a
# silent "every browser request gets blocked" failure, not a crash — this
# phase's own testing hit exactly that class of mismatch).
WEB_URL=https://<real-frontend-domain>
API_URL=https://<real-gateway-domain>
AI_SERVICE_URL=http://<real-ai-service-host>:8000
CORS_ORIGINS=https://<real-frontend-domain>

# Frontend — baked into the client bundle at BUILD time (not read at
# container start — see infra/docker/web.Dockerfile's ARG/ENV pair). Must
# be the gateway's real public /v1 origin; getting this wrong means a
# rebuild, not a config change.
NEXT_PUBLIC_API_URL=https://<real-gateway-domain>/v1
